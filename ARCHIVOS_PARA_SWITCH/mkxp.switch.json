{
    // =========================================================================
    // Configuración optimizada de mkxp-z para Nintendo Switch (Horizon OS)
    // =========================================================================

    "windowTitle": "Pokémon Añil 4.0",

    // Resolución del framebuffer en Switch (512x384)
    "defScreenW": 512,
    "defScreenH": 384,

    // Pantalla completa por defecto en Switch (Handheld 720p / Docked 1080p)
    // fixedAspectRatio = true -> Escala 4:3 ocupando el 100% del alto (960x720) centrado
    // fixedAspectRatio = false -> Escala 16:9 ocupando el 100% de la pantalla (1280x720 estirado)
    "fullscreen": true,
    "winResizable": false,
    "fixedAspectRatio": true,
    "integerScalingActive": false,
    "integerScalingLastMile": false,
    "smoothScaling": true,
    "lanczos3Scaling": false,
    "enableBlitting": false,

    // Sincronización y velocidad fluida con VSync estable a 60fps
    "vsync": true,
    "syncToRefreshrate": true,
    "fixedFramerate": 0,
    "subImageFix": true,
    "enableReset": false,
    "enableSettings": false,
    "preloadScript": [],

    // Fuentes y sustituciones para evitar textos deformados o borrosos
    "defaultFontFamily": "Power Clear",
    "fontScale": 1.0,
    "fontSub": [
      "Power Green>Power Clear",
      "Power Green Narrow>Power Clear",
      "Power Green Small>Power Clear",
      "Power Red and Blue>Power Clear",
      "Power Red and Green>Power Clear",
      "Arial>Power Clear",
      "MS Gothic>Power Clear",
      "SimSun>Power Clear",
      "Tahoma>Power Clear",
      "Segoe UI>Power Clear",
      "Calibri>Power Clear",
      "Annon>Power Clear",
      "Sword>Power Clear"
    ],

    // Cache de rutas para sistemas de archivos FAT32/exFAT (insensible a mayúsculas/minúsculas)
    "pathCache": true,

    // Directorio de datos de guardado (en Switch se guarda en sdmc:/switch/port/save o directorio local)
    "dataPathApp": "PokemonAnil",
    "dataPathOrg": "EricLostie",

    // Audio
    "midiSoundFont": "soundfont.sf2",
    "BGMTrackCount": 1,
    "SESourceCount": 12,

    // Mapeo de botones para Joy-Con / Nintendo Switch Pro Controller (SDL2 GameController API)
    "bindingNames": {
      "c": "Aceptar / Interactuar (A)",
      "b": "Cancelar / Correr (B)",
      "a": "Menú / Acción (X)",
      "x": "Atajo / Registrar (Y)",
      "y": "Modo Turbo (L)",
      "z": "Repelente (R)",
      "l": "Pokémontura / Volar (ZL)",
      "r": "Pokéradar (ZR)"
    }
}
