+static VALUE zlib_inflate_inflate(int argc, VALUE *argv, VALUE self) {
+    VALUE str;
+    rb_scan_args(argc, argv, "1", &str);
+    StringValue(str);
+    const char *src = RSTRING_PTR(str);
+    long srcLen = RSTRING_LEN(str);
+    if (srcLen == 0) return rb_str_new("", 0);
+
+    z_stream zs;
+    memset(&zs, 0, sizeof(zs));
+    if (inflateInit2(&zs, 15 + 32) != Z_OK) {
+        if (inflateInit2(&zs, -15) != Z_OK) {
+            rb_raise(rb_eRuntimeError, "Failed to initialize zlib inflate");
+        }
+    }
+
+    zs.next_in = (Bytef*)src;
+    zs.avail_in = srcLen;
+
+    VALUE out = rb_str_buf_new(srcLen * 2 + 1024);
+    char buf[16384];
+    int ret;
+    do {
+        zs.next_out = (Bytef*)buf;
+        zs.avail_out = sizeof(buf);
+        ret = inflate(&zs, Z_NO_FLUSH);
+        if (ret != Z_OK && ret != Z_STREAM_END && ret != Z_BUF_ERROR) {
+            inflateEnd(&zs);
+            rb_raise(rb_eRuntimeError, "zlib inflate error %d", ret);
+        }
+        long have = sizeof(buf) - zs.avail_out;
+        if (have > 0) {
+            rb_str_buf_cat(out, buf, have);
+        }
+    } while (ret != Z_STREAM_END && zs.avail_out == 0);
+
+    inflateEnd(&zs);
+    return out;
+}
+
+static VALUE zlib_deflate_deflate(int argc, VALUE *argv, VALUE self) {
+    VALUE str;
+    VALUE level_v;
+    int level = Z_DEFAULT_COMPRESSION;
+    if (rb_scan_args(argc, argv, "11", &str, &level_v) == 2) {
+        level = NUM2INT(level_v);
+    }
+    StringValue(str);
+    const char *src = RSTRING_PTR(str);
+    long srcLen = RSTRING_LEN(str);
+
+    uLongf destLen = compressBound(srcLen);
+    VALUE out = rb_str_buf_new(destLen);
+    rb_str_set_len(out, destLen);
+    if (compress((Bytef*)RSTRING_PTR(out), &destLen, (const Bytef*)src, srcLen) != Z_OK) {
+        rb_raise(rb_eRuntimeError, "zlib deflate error");
+    }
+    rb_str_set_len(out, destLen);
+    return out;
+}
+
+static VALUE zlib_crc32(int argc, VALUE *argv, VALUE self) {
+    VALUE str, crc_v;
+    uLong crc = 0;
+    if (rb_scan_args(argc, argv, "11", &str, &crc_v) == 2) {
+        crc = (uLong)NUM2ULONG(crc_v);
+    }
+    if (NIL_P(str)) return ULONG2NUM(crc32(crc, Z_NULL, 0));
+    StringValue(str);
+    crc = crc32(crc, (const Bytef*)RSTRING_PTR(str), RSTRING_LEN(str));
+    return ULONG2NUM(crc);
+}
+
+static void init_zlib_module() {
+    VALUE mZlib = rb_define_module("Zlib");
+    VALUE cInflate = rb_define_class_under(mZlib, "Inflate", rb_cObject);
+    VALUE cDeflate = rb_define_class_under(mZlib, "Deflate", rb_cObject);
+
+    rb_define_singleton_method(cInflate, "inflate", (VALUE(*)(...))zlib_inflate_inflate, -1);
+    rb_define_method(cInflate, "inflate", (VALUE(*)(...))zlib_inflate_inflate, -1);
+    rb_define_singleton_method(cDeflate, "deflate", (VALUE(*)(...))zlib_deflate_deflate, -1);
+    rb_define_method(cDeflate, "deflate", (VALUE(*)(...))zlib_deflate_deflate, -1);
+    rb_define_singleton_method(mZlib, "crc32", (VALUE(*)(...))zlib_crc32, -1);
+    rb_define_module_function(mZlib, "crc32", (VALUE(*)(...))zlib_crc32, -1);
+    rb_define_singleton_method(mZlib, "inflate", (VALUE(*)(...))zlib_inflate_inflate, -1);
+    rb_define_module_function(mZlib, "inflate", (VALUE(*)(...))zlib_inflate_inflate, -1);
+    rb_define_singleton_method(mZlib, "deflate", (VALUE(*)(...))zlib_deflate_deflate, -1);
+    rb_define_module_function(mZlib, "deflate", (VALUE(*)(...))zlib_deflate_deflate, -1);
+
+    rb_eval_string(
+        "module Zlib\n"
+        "  class Error < StandardError; end\n"
+        "  class GzipReader\n"
+        "    def self.open(filename, &block)\n"
+        "      content = File.binread(filename)\n"
+        "      inflated = Zlib::Inflate.inflate(content)\n"
+        "      io = StringIO.new(inflated)\n"
+        "      if block_given?\n"
+        "        yield io\n"
+        "      else\n"
+        "        io\n"
+        "      end\n"
+        "    end\n"
+        "  end\n"
+        "end\n"
+    );
+}
