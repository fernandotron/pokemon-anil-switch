+  static const char *const known[] = {
+    "png",  "wav",  "ogg",  "rb",   "rxdata", "txt",  "mp3",  "dat",
+    "ttf",  "otf",  "jpg",  "jpeg", "gif",    "bmp",  "mid",  "midi",
+    "flac", "json", "csv",  "sf2",  "ini",    "log",  "bak",  "xml",
+    "yaml", "yml",  "py",   "exe",  "nro",    "nacp", "webp", "m4a"
+  };
+
+  for (size_t i = 0; i < sizeof(known) / sizeof(known[0]); ++i)
+    if (strcmp(ext, known[i]) == 0)
+      return true;
+
+  return false;
+}
